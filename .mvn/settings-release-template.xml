<?xml version="1.0" encoding="UTF-8"?>
<!--
  发布凭据模板：复制为 settings-local.xml 后按需填写，secrets 一律走环境变量。
  本模板不含任何真实凭据，可安全入库；.gitignore 已忽略 settings-*.xml（本模板除外），
  复制出的本地文件不会被误提交。

  用法（凭据环境变量见各 server 注释，建议在发布机 profile / CI secrets 中注入）：

  1) Maven Central 正式发布（Central Portal 校验通过后自动发布）：
     ./mvnw -s .mvn/settings-local.xml -Prelease clean deploy

  2) 个人依赖仓库（云效 Packages / Nexus / Artifactory），无需改动仓库默认配置：
     ./mvnw -s .mvn/settings-local.xml clean deploy \
       -DaltDeploymentRepository=personal::default::<仓库上传地址>

     云效示例（仓库地址在云效 Packages 页面复制）：
     -DaltDeploymentRepository=personal::default::https://packages.aliyun.com/maven/repository/xxxx-release/maven
     Nexus 示例（hosted 仓库）：
     -DaltDeploymentRepository=personal::default::http://nexus.local:8081/repository/maven-releases/

  3) GitHub Packages SNAPSHOT 预览（走父 pom distributionManagement 的 github 仓库）：
     ./mvnw -s .mvn/settings-local.xml clean deploy -DskipTests

  4) 使用方拉取：在业务工程 settings.xml 中将同一 <server>（id 按需）用于下载凭据，
     并把仓库地址加入 <profiles><repositories> 或 <mirrorOf>。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <servers>
        <!-- Maven Central：central.sonatype.com → 账户 → View User Token
             需要 CENTRAL_USERNAME（令牌用户名）与 CENTRAL_TOKEN（令牌密码） -->
        <server>
            <id>central</id>
            <username>${env.CENTRAL_USERNAME}</username>
            <password>${env.CENTRAL_TOKEN}</password>
        </server>

        <!-- GitHub Packages：PAT 需要 write:packages/read:packages
             需要 GITHUB_ACTOR（用户名）与 GITHUB_TOKEN（PAT） -->
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>

        <!-- GPG 签名口令（maven-gpg-plugin 3.x 约定：server id 固定为 gpg.passphrase）
             需要 GPG_PASSPHRASE；密钥本体在发布机 gpg 环节生成，见 docs/release-guide.md §1 -->
        <server>
            <id>gpg.passphrase</id>
            <passphrase>${env.GPG_PASSPHRASE}</passphrase>
        </server>

        <!-- 个人依赖仓库：与 -DaltDeploymentRepository=personal::default::... 中的 id 对应
             需要 REPO_USERNAME 与 REPO_PASSWORD -->
        <server>
            <id>personal</id>
            <username>${env.REPO_USERNAME}</username>
            <password>${env.REPO_PASSWORD}</password>
        </server>
    </servers>

</settings>
